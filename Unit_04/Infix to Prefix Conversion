#include <iostream>
#include <stack>
#include <algorithm>
using namespace std;

int prec(char c) {
    if (c == '^') return 3;
    if (c == '*' || c == '/') return 2;
    if (c == '+' || c == '-') return 1;
    return 0;
}

string toPostfix(string s) {
    stack<char> st;
    string result = "";

    for (char c : s) {
        if (c == ' ') continue;

        if (isalnum(c))
            result += c;
        else if (c == '(')
            st.push(c);
        else if (c == ')') {
            while (!st.empty() && st.top() != '(') {
                result += st.top();
                st.pop();
            }
            if (!st.empty()) st.pop();
        }
        else {
            while (!st.empty() && st.top() != '(' &&
                  (prec(st.top()) > prec(c) ||
                  (prec(st.top()) == prec(c) && c != '^'))) {
                result += st.top();
                st.pop();
            }
            st.push(c);
        }
    }

    while (!st.empty()) {
        result += st.top();
        st.pop();
    }

    return result;
}

int main() {
    string infix;

    cout << "Enter infix expression: ";
    getline(cin, infix);

    reverse(infix.begin(), infix.end());

    for (char &c : infix) {
        if (c == '(') c = ')';
        else if (c == ')') c = '(';
    }

    string postfix = toPostfix(infix);

    reverse(postfix.begin(), postfix.end());

    cout << "Prefix Expression: " << postfix;

    return 0;
}
