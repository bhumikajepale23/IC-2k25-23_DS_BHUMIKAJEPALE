#include <iostream>
using namespace std;
int main() {
    // Write C++ code here
    int arr[2][3]={
        {1,2,3},
        {4,5,6}
    };
    int smallest = arr[0][0];
    
    
    for(int i=0; i<2; i++){
        for(int j=0; j<3; j++)
    {     
        if (arr[i][j] < smallest);
        {
            smallest = arr[i][j];
        }
    }
    cout<<"Smallest element is:"<< smallest << endl ;
    
    }
    return 0;
}
