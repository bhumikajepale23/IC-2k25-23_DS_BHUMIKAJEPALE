#include <iostream>
using namespace std;

int getMax(int arr[], int n) {
    int mx = arr[0];

    for (int i = 1; i < n; i++) {
        if (arr[i] > mx)
            mx = arr[i];
    }

    return mx;
}

void countingSort(int arr[], int n, int exp) {
    int output[100];
    int count[10] = {0};

    for (int i = 0; i < n; i++)
        count[(arr[i] / exp) % 10]++;

    for (int i = 1; i < 10; i++)
        count[i] += count[i - 1];

    for (int i = n - 1; i >= 0; i--) {
        int digit = (arr[i] / exp) % 10;
        output[count[digit] - 1] = arr[i];
        count[digit]--;
    }

    for (int i = 0; i < n; i++)
        arr[i] = output[i];
}

void radixSort(int arr[], int n) {
    int mx = getMax(arr, n);

    for (int exp = 1; mx / exp > 0; exp *= 10)
        countingSort(arr, n, exp);
}

int main() {
    int arr[100], n;

    cout << "Enter array size: ";
    cin >> n;

    cout << "Enter non-negative elements: ";
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    if (n <= 0 || n > 100) {
        cout << "Invalid array size!";
        return 0;
    }

    bool valid = true;
    for (int i = 0; i < n; i++) {
        if (arr[i] < 0)
            valid = false;
    }

    if (!valid) {
        cout << "Negative numbers are not supported!";
        return 0;
    }

    radixSort(arr, n);

    cout << "Sorted array: ";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";

    return 0;
}
