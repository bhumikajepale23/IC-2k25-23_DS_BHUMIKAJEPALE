#include <iostream>
using namespace std;

int main() {
    int n, edges;
    int graph[20][20] = {0};

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> edges;

    cout << "Enter edges (u v):\n";

    for (int i = 0; i < edges; i++) {
        int u, v;
        cin >> u >> v;

        if (u >= 0 && u < n && v >= 0 && v < n) {
            graph[u][v] = 1;
            graph[v][u] = 1;
        }
    }

    cout << "\nAdjacency Matrix:\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++)
            cout << graph[i][j] << " ";

        cout << endl;
    }

    return 0;
}
