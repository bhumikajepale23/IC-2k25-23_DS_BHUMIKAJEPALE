#include <iostream>
#include <queue>
using namespace std;

int main() {
    priority_queue<int, vector<int>, greater<int>> pq;

    int choice, value;

    do {
        cout << "\n1. Insert\n2. Delete\n3. Display\n0. Exit";
        cout << "\nEnter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter value: ";
                cin >> value;
                pq.push(value);
                break;

            case 2:
                if (pq.empty())
                    cout << "Queue is empty!";
                else {
                    cout << "Deleted: " << pq.top();
                    pq.pop();
                }
                break;

            case 3: {
                priority_queue<int, vector<int>, greater<int>> temp = pq;

                while (!temp.empty()) {
                    cout << temp.top() << " ";
                    temp.pop();
                }
                break;
            }
        }

    } while (choice != 0);

    return 0;
}
