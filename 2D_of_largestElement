#include <iostream>
using namespace std;
int main() {
    // Write C++ code here
    int arr[2][3]={
        {1,2,3},
        {4,5,6}
    };
    int largest = arr[0][0];
    
    
    for(int i=0; i<2; i++){
        for(int j=0; j<3; j++)
    {     
        if (arr[i][j]>largest);
        {
            largest = arr[i][j];
        }
    }
    cout<<"largest element is:"<< largest ;
    cout<<endl;
    }
    return 0;
}

