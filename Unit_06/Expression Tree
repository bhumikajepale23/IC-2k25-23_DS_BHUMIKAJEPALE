#include <iostream>
#include <stack>
#include <string>
using namespace std;

struct Node {
    char data;
    Node* left;
    Node* right;
};

bool isOperator(char c) {
    return c == '+' || c == '-' ||
           c == '*' || c == '/';
}

Node* createNode(char c) {
    Node* n = new Node();

    n->data = c;
    n->left = n->right = NULL;

    return n;
}

Node* buildTree(string postfix) {
    stack<Node*> s;

    for (char c : postfix) {
        Node* node = createNode(c);

        if (isOperator(c)) {
            node->right = s.top();
            s.pop();

            node->left = s.top();
            s.pop();
        }

        s.push(node);
    }

    return s.top();
}

void inorder(Node* root) {
    if (root == NULL) return;

    if (isOperator(root->data))
        cout << "(";

    inorder(root->left);
    cout << root->data;
    inorder(root->right);

    if (isOperator(root->data))
        cout << ")";
}

int main() {
    string postfix;

    cout << "Enter postfix expression: ";
    cin >> postfix;

    Node* root = buildTree(postfix);

    cout << "Infix Expression: ";
    inorder(root);

    return 0;
}
